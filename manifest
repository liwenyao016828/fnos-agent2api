appname               = agent2api
version               = 3.2.0-beta.2-1
display_name          = Agent2API
desc                  = <b>多提供商账号池 → OpenAI 兼容 API 网关</b>（基于上游 agent2api v3.2.0-beta.2 预发布版），内置官方 Web 控制台与手机端页面；单文件静态二进制，<b>无需 Docker、无需 Node 运行时</b>，安装即用。<br><br>🤖 <b>账号池 → 标准 API：</b><br>- 标准 <code>/v1/chat/completions</code>、<code>/v1/responses</code>、<code>/v1/messages</code>、<code>/v1/models</code><br>- 多账号轮转、失败重试，本地 SQLite 持久化<br>- 内置 WorkBuddy、小浣熊（Raccoon）、CatPaw、AutoClaw、Qoder、Cline、Trae、ZCode、CodeArts、智谱清言等多家适配，另支持自定义提供商<br><br>🖥️ <b>官方控制台（v3.2.0-beta.2 面板，213 个文件）：</b><br>- 账号管理、模型中心、API 密钥、运行日志、请求报表、定时任务、余额查询、对话测试台<br>- 界面支持简体中文、繁體中文、English、日本語、한국어、Português (BR) 六种语言（简体中文以「中文即键」的基准文案承载）<br>- 手机端入口 <code>/m</code>，并提供 PWA 资源（<code>manifest.webmanifest</code> + <code>sw.js</code>；经网关子路径运行时「添加到主屏」受限，见项目说明）<br>- 统一网关接入，复用飞牛登录态，<b>面板无需独立登录密码</b>，仅管理员可访问<br><br>🔌 <b>下游接入：</b><br>- 独立端口 <code>http://＜飞牛IP＞:3065/v1</code>，任意 OpenAI SDK 直连（统一网关路径仅供面板访问，外部客户端走不通）<br><br>🧩 <b>运行时说明：</b><br>- 上游为 Rust 静态二进制，要求 glibc ≥ 2.34（实测引用的最高 GLIBC 符号版本），飞牛 fnOS 1.2.x 为 2.36，满足；<b>不依赖应用中心 Node.js 运行时</b><br>- SQLite 以 bundled 方式静态链接，运行时无额外系统依赖<br>- 账号凭据在应用数据目录中以明文存储，请勿在多人共享设备上使用

# 系统要求
# platform 由 build.py 按目标架构改写为 x86 / arm：每个 fpk 只装一个架构的二进制。
# 写成 all 会让另一种架构也能装上跑不起来的包。
platform              = all
os_min_version        = 1.2.0401
source                = thirdparty

# 开发者信息
maintainer            = Agent2API
maintainer_url        = https://github.com/Agent2API/agent2api

distributor           = sushazhi
distributor_url       = https://github.com/sushazhi/fnos-agent2api

# 安装控制
ctl_stop              = true

# 下游接入端口（OpenAI 兼容客户端直连；取上游默认端口 3065，统一网关路径不给外部客户端用）
service_port          = 3065
checkport             = true

# 桌面图标配置
desktop_uidir         = ui
desktop_applaunchname = agent2api.Application

# 更新日志
changelog             = v3.2.0-beta.2-1（预发布）<br>1.跟随上游预发布 v3.2.0-beta.2，零源码改动：官方 Linux 服务端包两个架构的 sha256 已重新钉住（amd64 9,343,829 B、arm64 8,925,518 B），二进制由已验证的官方包离线取用<br>2.上游面板从 208 个文件涨到 213 个（新增 sidebar-layout.js、css/page-sidebar-pane.css 与 atomcode / lobsterai / modelscope 三个图标，图标总数 41 → 44）；界面语言集合未变，仍是六种界面语言：简体中文以「中文即键」的基准文案承载，另有 en / ja / ko / pt-BR / zh-Hant 五个词典目录，本次变化只是各语言词典内容更新（53 个文件）<br>3.构建期新增「上游二进制溯源 sidecar」守卫，阻断「同步过面板但没重取二进制」导致的版本错配 —— 此前这条路径会让 arm64 包装进上一版二进制而全部守卫绿灯<br>4.已知问题（非阻断，依据本包内置面板静态核对）：上游把「退出登录」改成三目写法 location.href=e?login.html:/login，网关的导航改写正则只在 location.href= 后紧跟字面量时生效，故该处命中 0 次（上一版 1 次）；在飞牛里点退出会跳到站点根 /login 而非应用内的 /login，需手动改地址栏返回，或等下一版修复<br>5.如实说明：上游仓库 Agent2API/agent2api 实测已返回 404（账号与仓库都不存在），源码与官方资产已无法下载，本包只能由已落地的官方包离线构建；预发布版建议先在测试机验证再升级
